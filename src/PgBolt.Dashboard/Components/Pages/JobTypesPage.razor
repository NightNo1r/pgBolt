<h1>Job types</h1>
<div class="pgbolt-table-wrap">
    <table>
        <thead>
            <tr><th>Type</th><th>Queue</th><th>Attempts</th><th>Priority</th><th>Published by</th><th>Last seen</th>@if (Context.CanAct) { <th></th> }</tr>
        </thead>
        <tbody>
            @foreach (var t in Types)
            {
                <tr>
                    <td>@t.Name</td>
                    <td>@t.DefaultQueue</td>
                    <td>@t.DefaultMaxAttempts</td>
                    <td>@t.DefaultPriority</td>
                    <td>@t.PublishedBy</td>
                    <td><Time Utc="t.LastSeenAt" /></td>
                    @if (Context.CanAct)
                    {
                        <td><a href="types/enqueue?name=@Uri.EscapeDataString(t.Name)">Enqueue</a></td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public IReadOnlyList<JobTypeRow> Types { get; set; } = [];
    [Parameter] public DashboardContext Context { get; set; } = null!;
}

@using System.Globalization
@using Microsoft.AspNetCore.WebUtilities
<h1>Jobs</h1>
<nav class="pgbolt-tabs">
    @foreach (var k in Enum.GetValues<JobState>())
    {
        <a href="jobs/@k.ToString().ToLowerInvariant()" aria-current="@(k == Kind ? "page" : null)">@k</a>
    }
</nav>
@if (Kind is JobState.Failed or JobState.Cancelled)
{
    <p class="muted">Transitions over @(Context.EventsRetention is { } r ? r.TotalDays.ToString("0.##", CultureInfo.InvariantCulture) + " days" : "the retention period")</p>
}
@if (Page is null)
{
    <p>Select a queue:</p>
    <ul>
        @foreach (var q in Queues ?? [])
        {
            <li><a href="jobs/enqueued?queue=@Uri.EscapeDataString(q.Name)" hx-push-url="true">@q.Name</a></li>
        }
    </ul>
    @if (Queues is not { Count: > 0 })
    {
        <p class="muted">No queues</p>
    }
}
else
{
    <form class="pgbolt-filter" method="get" action="jobs/@Name" hx-push-url="true">
        <input name="queue" value="@Queue" placeholder="queue">
        <input name="type" value="@Type" placeholder="type">
        <button>Apply</button>
        <a href="@BaseUrl">Refresh</a>
    </form>
    @if (Context.CanAct)
    {
        @* Контейнер чекбоксов ids: цель и свап — у каждой кнопки свои (наследование htmx отключено), type="button" — без нативного submit. *@
        <form class="pgbolt-bulk">
            <p>
                <button type="button" class="danger" hx-post="actions/jobs/cancel" hx-target="#bulk-result" hx-swap="innerHTML">Cancel selected</button>
                <button type="button" hx-post="actions/jobs/trigger" hx-target="#bulk-result" hx-swap="innerHTML">Trigger selected</button>
                <button type="button" hx-post="actions/jobs/requeue" hx-target="#bulk-result" hx-swap="innerHTML">Requeue selected</button>
            </p>
            @Table
        </form>
        <div id="bulk-result"></div>
    }
    else
    {
        @Table
    }
    @if (Page.Rows.Count == 0)
    {
        <p class="muted">No jobs</p>
    }
    <Pager Next="@Page.Next" ScannedTo="Page.ScannedTo" BaseUrl="@BaseUrl" />
}

@code {
    [Parameter] public JobState Kind { get; set; }
    [Parameter] public string? Queue { get; set; }
    [Parameter] public string? Type { get; set; }

    /// <summary>Null on the Enqueued tab until the user selects a queue from <see cref="Queues"/>.</summary>
    [Parameter] public Page<JobListRow>? Page { get; set; }

    [Parameter] public IReadOnlyList<QueueRow>? Queues { get; set; }
    [Parameter] public DashboardContext Context { get; set; } = null!;

    /// <summary>Renders the job table inside a bulk action form when actions are available.</summary>
    private RenderFragment Table => @<div class="pgbolt-table-wrap">
        <table>
            <thead>
                <tr>
                    @if (Context.CanAct)
                    {
                        <th><input type="checkbox" data-pgbolt-select-all aria-label="Select all"></th>
                    }
                    <th>Id</th><th>Type</th><th>Queue</th><th>Priority</th><th>Attempt</th><th>Created</th>
                    @switch (Kind)
                    {
                        case JobState.Scheduled or JobState.Enqueued:
                            <th>Run at</th>
                            break;
                        case JobState.Processing:
                            <th>Started</th><th>Server</th>
                            break;
                        case JobState.Succeeded:
                            <th>Finished</th>
                            break;
                        case JobState.Failed or JobState.Cancelled:
                            <th>Finished</th><th>Event</th><th>Message</th>
                            break;
                    }
                    @if (Context.CanAct)
                    {
                        <th>Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Page!.Rows)
                {
                    <JobRow Row="row" Kind="Kind" Context="Context" />
                }
            </tbody>
        </table>
    </div>;

    private string Name => Kind.ToString().ToLowerInvariant();

    /// <summary>Tab URL with filters, excluding the after cursor.</summary>
    private string BaseUrl => QueryHelpers.AddQueryString($"jobs/{Name}", new Dictionary<string, string?> { ["queue"] = Queue, ["type"] = Type });
}

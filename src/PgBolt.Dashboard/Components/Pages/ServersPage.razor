<h1>Servers</h1>
<div class="pgbolt-table-wrap">
    <table>
        <thead>
            <tr><th>Name</th><th>Host</th><th>Queues</th><th>Capacity</th><th>Started</th><th>Heartbeat</th><th>Succeeded (last hour)</th><th>Failed (last hour)</th><th>Retried (last hour)</th></tr>
        </thead>
        <tbody>
            @foreach (var s in Data.Servers)
            {
                <tr>
                    <td>@s.Name</td>
                    <td>@s.Host</td>
                    <td>@string.Join(", ", s.Queues)</td>
                    <td>@s.Capacity</td>
                    <td><Time Utc="s.StartedAt" /></td>
                    <td><Time Utc="s.HeartbeatAt" />@if (s.Stale) { <span class="failed"> unresponsive</span> }</td>
                    <td>@s.Succeeded</td>
                    <td>@s.Failed</td>
                    <td>@s.Retried</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<h2>Maintenance tasks</h2>
<div class="pgbolt-table-wrap">
    <table>
        <thead>
            <tr><th>Task</th><th>Last run</th><th>Finished</th><th>Next run</th><th>State</th><th>Error</th></tr>
        </thead>
        <tbody>
            @foreach (var t in Data.Tasks)
            {
                <tr>
                    <td>@t.Name</td>
                    <td><Time Utc="t.LastRunAt" /></td>
                    <td><Time Utc="t.LastFinishedAt" /></td>
                    <td><Time Utc="t.NextRunAt" /></td>
                    <td>@(t.Running ? "running" : "")</td>
                    <td>@if (t.LastError is { } error) { <pre>@error</pre> }</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public ServersData Data { get; set; } = null!;
}

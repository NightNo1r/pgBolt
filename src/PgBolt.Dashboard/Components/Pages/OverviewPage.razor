<h1>Overview</h1>
<section hx-get="overview/hour" hx-trigger="every @((long)Context.RefreshInterval.TotalMilliseconds)ms, pgbolt:refresh" hx-swap="innerHTML" hx-target="this" data-pgbolt-poll>
    <HourPanel Data="Data" />
</section>
<section hx-get="overview/day" hx-trigger="load, every 60000ms, pgbolt:refresh" hx-swap="innerHTML" hx-target="this" data-pgbolt-poll>
    <p class="muted">Loading…</p>
</section>
<p class="muted">Statistics are approximate. They count outcomes acknowledged by workers. Jobs that failed when their lease expired appear in the Failed list only.</p>

@code {
    [Parameter] public OverviewData Data { get; set; } = null!;
    [Parameter] public DashboardContext Context { get; set; } = null!;
}

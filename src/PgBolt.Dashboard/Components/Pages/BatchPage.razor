<article class="pgbolt-card">
    <h1>Batch @Batch.Id <StateBadge State="Batch.State" /></h1><BatchActions Batch="Batch" Context="Context" />
    <dl class="pgbolt-props">
        <dt>Progress</dt><dd>@Batch.Succeeded / @Batch.Total</dd>
        <dt>Failed</dt><dd>@Batch.Failed</dd>
        <dt>Cancelled</dt><dd>@Batch.Cancelled</dd>
        <dt>Created</dt><dd><Time Utc="Batch.CreatedAt.UtcDateTime" /></dd>
        <dt>Finished</dt><dd><Time Utc="Batch.FinishedAt?.UtcDateTime" /></dd>
        @if (Batch.CancellationRequested)
        {
            <dt>Cancellation</dt><dd>requested</dd>
        }
        @if (Batch.OuterBatchId is { } outer)
        {
            <dt>Outer batch</dt><dd><a href="batches/@outer">@outer</a></dd>
        }
        @if (Batch.ParentId is { } parent)
        {
            <dt>Parent</dt><dd><a href="jobs/@parent">@parent</a></dd>
        }
        else if (Batch.ParentBatchId is { } parentBatch)
        {
            <dt>Parent</dt><dd><a href="batches/@parentBatch">@parentBatch</a></dd>
        }
        @if (Batch.Condition is { } condition)
        {
            <dt>Condition</dt><dd>@condition</dd>
        }
    </dl>
    <h2>Jobs</h2>
    <ul hx-get="batches/@Batch.Id/jobs" hx-trigger="load" hx-target="this" hx-swap="innerHTML"><li class="muted">Loading…</li></ul>
    <h2>Nested batches</h2>
    <ul hx-get="batches/@Batch.Id/nested" hx-trigger="load" hx-target="this" hx-swap="innerHTML"><li class="muted">Loading…</li></ul>
    <h2>Continuations</h2>
    <ul hx-get="batches/@Batch.Id/continuations" hx-trigger="load" hx-target="this" hx-swap="innerHTML"><li class="muted">Loading…</li></ul>
    <h2>Batch continuations</h2>
    <ul hx-get="batches/@Batch.Id/batch-continuations" hx-trigger="load" hx-target="this" hx-swap="innerHTML"><li class="muted">Loading…</li></ul>
</article>

@code {
    [Parameter] public BatchInfo Batch { get; set; } = null!;
    [Parameter] public DashboardContext Context { get; set; } = null!;
}

<h1>Batches</h1>
<nav class="pgbolt-tabs">
    <a href="batches" aria-current="@(State is null ? "page" : null)">All</a>
    @foreach (var s in Enum.GetValues<BatchState>())
    {
        <a href="batches?state=@s" aria-current="@(s == State ? "page" : null)">@s</a>
    }
</nav>
<div class="pgbolt-table-wrap">
    <table>
        <thead>
            <tr><th>Id</th><th>State</th><th>Succeeded / total</th><th>Failed</th><th>Cancelled</th><th>Created</th><th>Finished</th></tr>
        </thead>
        <tbody>
            @foreach (var b in Page.Rows)
            {
                <tr>
                    <td><a href="batches/@b.Id">@b.Id</a>@if (b.CancelRequested) { <span class="muted"> cancellation requested</span> }</td>
                    <td><StateBadge State="b.State" /></td>
                    <td>@b.Succeeded / @b.Total</td>
                    <td>@b.Failed</td>
                    <td>@b.Cancelled</td>
                    <td><Time Utc="b.CreatedAt" /></td>
                    <td><Time Utc="b.FinishedAt" /></td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (Page.Rows.Count == 0)
{
    <p class="muted">No batches</p>
}
<Pager Next="@Page.Next" ScannedTo="Page.ScannedTo" BaseUrl="@(State is null ? "batches" : $"batches?state={State}")" />

@code {
    [Parameter] public BatchState? State { get; set; }
    [Parameter] public Page<BatchRow> Page { get; set; } = null!;
}

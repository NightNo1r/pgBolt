<h1>Recurring</h1>
<div class="pgbolt-table-wrap">
    <table>
        <thead>
            <tr><th>Id</th><th>Тип</th><th>Cron</th><th>Часовой пояс</th><th>Владелец</th><th>Следующий запуск</th><th>Последний запуск</th><th>Ошибка</th>@if (Context.CanAct) { <th>Действия</th> }</tr>
        </thead>
        <tbody>
            @foreach (var r in Page.Rows)
            {
                <RecurringListRow Row="r" Context="Context" />
            }
        </tbody>
    </table>
</div>
@if (Page.Rows.Count == 0)
{
    <p class="muted">расписаний нет</p>
}
<Pager Next="@Page.Next" ScannedTo="Page.ScannedTo" BaseUrl="recurring" />

@code {
    /// <summary>Число колонок таблицы при CanAct (с «Действия»): заглушка удалённой строки занимает их все.</summary>
    internal const int ActColumns = 9;

    [Parameter] public Page<RecurringRow> Page { get; set; } = null!;
    [Parameter] public DashboardContext Context { get; set; } = null!;
}

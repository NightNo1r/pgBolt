<h1>Recurring</h1>
<div class="pgbolt-table-wrap">
    <table>
        <thead>
            <tr><th>Id</th><th>Type</th><th>Cron</th><th>Time zone</th><th>Owner</th><th>Next run</th><th>Last run</th><th>Error</th>@if (Context.CanAct) { <th>Actions</th> }</tr>
        </thead>
        <tbody>
            @foreach (var r in Page.Rows)
            {
                <RecurringListRow Row="r" Context="Context" />
            }
        </tbody>
    </table>
</div>
@if (Page.Rows.Count == 0)
{
    <p class="muted">No schedules</p>
}
<Pager Next="@Page.Next" ScannedTo="Page.ScannedTo" BaseUrl="recurring" />

@code {
    /// <summary>Number of columns when actions are enabled. The placeholder for a deleted row spans them all.</summary>
    internal const int ActColumns = 9;

    [Parameter] public Page<RecurringRow> Page { get; set; } = null!;
    [Parameter] public DashboardContext Context { get; set; } = null!;
}

@* Заглушка после удаления расписания: заменяет строку (<tr>) или карточку (<article>) — цель hx-target кнопки. *@
@if (Card)
{
    <article class="pgbolt-card"><p class="muted">schedule deleted</p></article>
}
else
{
    <tr><td colspan="@Pages.RecurringListPage.ActColumns" class="muted">schedule deleted</td></tr>
}

@code {
    [Parameter] public bool Card { get; set; }
}

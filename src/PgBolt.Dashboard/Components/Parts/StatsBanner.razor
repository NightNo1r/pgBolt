@switch (Freshness.Kind)
{
    case StatsFreshnessKind.NotRunning:
        <div class="pgbolt-banner">The snapshot is stale. No process is running maintenance (<code>RunMaintenance</code>)</div>
        break;
    case StatsFreshnessKind.Failing:
        <div class="pgbolt-banner">Last statistics snapshot failed:<pre>@Freshness.Error</pre></div>
        break;
}

@code {
    [Parameter] public StatsFreshness Freshness { get; set; } = null!;
}

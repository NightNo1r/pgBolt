@using Microsoft.AspNetCore.WebUtilities
@if (Next is { } next)
{
    var href = QueryHelpers.AddQueryString(BaseUrl, "after", next);
    <p class="pgbolt-pager">
        @if (ScannedTo is { } scanned)
        {
            <text>Scanned through </text><Time Utc="scanned.UtcDateTime" /><text> — </text><a href="@href" hx-push-url="true">Continue search</a>
        }
        else
        {
            <a href="@href" hx-push-url="true">Next page</a>
        }
    </p>
}

@code {
    [Parameter] public string? Next { get; set; }
    [Parameter] public DateTimeOffset? ScannedTo { get; set; }

    /// <summary>List URL without the after cursor.</summary>
    [Parameter] public string BaseUrl { get; set; } = "";
}
